// Karkain-Quantum - quantum circuit model and backend abstraction.
// Karkain Language v1.2.0 verified baseline (tag v1.2.0,
// commit 77d70693e1e3134dac312a303bffafa7d50fa988).
//
// Scope boundary: v1.2.0 has NO quantum language surface. This framework
// models circuits as data and provides a deterministic single-qubit
// measurement preview for X gates. It is NOT a quantum simulator, does not
// implement superposition or entanglement, and does not target hardware.
//
// Circuit representation: [name, "gate:qubit", "gate:qubit", ...].

// new_circuit creates an empty named circuit.
public func new_circuit(name) {
    let c = []
    c = push(c, name)
    return c
}

// circuit_name returns the circuit name.
public func circuit_name(circuit) {
    return circuit[0]
}

// add_gate appends a gate targeting a qubit.
public func add_gate(circuit, g, qubit) {
    return push(circuit, g + ":" + str(qubit))
}

// gate_count returns the number of gates.
public func gate_count(circuit) {
    return len(circuit) - 1
}

// gate_at returns the nth encoded gate or "".
public func gate_at(circuit, n) {
    if n < gate_count(circuit) {
        return circuit[1 + n]
    }
    return ""
}

// x_gate_count counts X gates applied to a qubit.
public func x_gate_count(circuit, qubit) {
    let target = "X:" + str(qubit)
    let n = 0
    let i = 0
    while (i < gate_count(circuit)) {
        if gate_at(circuit, i) == target {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// measure_preview returns 1 when an odd number of X gates target the qubit.
// This is a deterministic teaching preview, not probabilistic measurement.
public func measure_preview(circuit, qubit) {
    if x_gate_count(circuit, qubit) % 2 == 1 {
        return 1
    }
    return 0
}

// circuit_summary builds a one-line circuit diagnostic.
public func circuit_summary(circuit) {
    return circuit_name(circuit) + ":gates=" + str(gate_count(circuit))
}
